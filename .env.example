# Copy to .env (read by Prisma CLI and Next.js) for local development.
# Production (NODE_ENV=production, e.g. `next start` or the container) refuses the example secrets below.
DATABASE_URL="postgresql://kydi:kydi@localhost:5432/kydi?schema=public"

# 32+ random characters. Signs session cookies. Generate: openssl rand -hex 32
SESSION_SECRET="dev-only-session-secret-please-change-0123456789"

# 32+ random characters, different from SESSION_SECRET. Encrypts stored mail/exchange-rate credentials.
# Never change it once credentials are stored. Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY="dev-only-encryption-key-please-change-0123456789"

# Public base URL used in emails and portal links. Optional: derived from request headers when unset.
APP_URL="http://localhost:3000"

# Where receipts and company logos are stored.
UPLOAD_DIR="./uploads"

# Shared secret for GET/POST /api/cron/recurring (Authorization: Bearer <CRON_SECRET>). 24+ characters.
CRON_SECRET="dev-cron-secret"

# Seed demo data automatically on boot when the database is empty (true/false).
KYDI_DEMO_SEED="false"

# Optional: only this email may create the first administrator (Zenith sets it from ZENITH_OWNER_EMAIL).
# KYDI_OWNER_EMAIL=""

# SMTP. When SMTP_HOST is empty, emails are logged to stdout instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Kydi <no-reply@kydi.local>"
