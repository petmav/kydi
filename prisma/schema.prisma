// Kydi data model.
// Money: signed 64-bit integers of minor units (major x 100). Quantities, percents and
// exchange rates are doubles rounded by the domain layer (2 / 2 / 6 decimals).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  USER
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  role          UserRole  @default(USER)
  settings      Json      @default("{}")
  /// Storage-relative path of the profile photo (spec §2.6), served by /api/files/avatar/[id].
  avatarPath    String?
  lastCompanyId Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   CompanyUser[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  ownedCompanies Company[] @relation("CompanyOwner")
  apiTokens     ApiToken[]
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String
  tokenHash  String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  slug       String   @unique
  uniqueHash String   @unique
  ownerId    Int
  vatId      String?
  taxId      String?
  logoPath   String?
  addrName   String?
  street1    String?
  street2    String?
  city       String?
  state      String?
  country    String?
  zip        String?
  phone      String?
  fax        String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner      User     @relation("CompanyOwner", fields: [ownerId], references: [id])
  members    CompanyUser[]
  roles      Role[]
  settings   CompanySetting[]
  invitations Invitation[]
  customers  Customer[]
  units      Unit[]
  items      Item[]
  taxTypes   TaxType[]
  invoices   Invoice[]
  estimates  Estimate[]
  recurringInvoices RecurringInvoice[]
  payments   Payment[]
  paymentMethods PaymentMethod[]
  expenses   Expense[]
  expenseCategories ExpenseCategory[]
  customFields CustomField[]
  notes      Note[]
  exchangeRateLogs ExchangeRateLog[]
  emailLogs  EmailLog[]
  mailConfig MailConfig?
  exchangeRateProviders ExchangeRateProvider[]
  suppliers  Supplier[]
  bills      Bill[]
  supplierPayments SupplierPayment[]
  recurringCosts RecurringCost[]
  paymentGateway PaymentGateway?
  onlinePayments OnlinePayment[]
}

model CompanySetting {
  id        Int     @id @default(autoincrement())
  companyId Int
  key       String
  value     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
}

model Role {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  title     String
  abilities String[]
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members   CompanyUser[]
  invitations Invitation[]

  @@unique([companyId, name])
}

model CompanyUser {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId])
  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Invitation {
  id          Int              @id @default(autoincrement())
  companyId   Int
  email       String
  roleId      Int
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById Int
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([companyId, email])
}

model Customer {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  creatorId          Int?
  name               String
  email              String?
  phone              String?
  contactName        String?
  companyName        String?
  website            String?
  prefix             String?
  taxId              String?
  currency           String
  enablePortal       Boolean  @default(false)
  /// Staff switched portal access off on purpose; invoices then never switch it back on automatically.
  portalOptOut       Boolean  @default(false)
  portalPasswordHash String?
  billingName        String?
  billingStreet1     String?
  billingStreet2     String?
  billingCity        String?
  billingState       String?
  billingCountry     String?
  billingZip         String?
  billingPhone       String?
  shippingName       String?
  shippingStreet1    String?
  shippingStreet2    String?
  shippingCity       String?
  shippingState      String?
  shippingCountry    String?
  shippingZip        String?
  shippingPhone      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
  estimates          Estimate[]
  recurringInvoices  RecurringInvoice[]
  payments           Payment[]
  expenses           Expense[]
  portalSessions     PortalSession[]
  onlinePayments     OnlinePayment[]

  @@unique([companyId, email])
  @@index([companyId, name])
}

model PortalSession {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  customerId Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model PortalResetToken {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique
  customerId Int
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Unit {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items     Item[]

  @@unique([companyId, name])
}

model Item {
  id          Int       @id @default(autoincrement())
  companyId   Int
  creatorId   Int?
  name        String
  description String?
  price       BigInt
  unitId      Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taxes       ItemTax[]
  lines       LineItem[]

  @@index([companyId, name])
}

model ItemTax {
  id        Int     @id @default(autoincrement())
  itemId    Int
  taxTypeId Int
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  taxType   TaxType @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)

  @@unique([itemId, taxTypeId])
}

enum TaxCalculation {
  PERCENTAGE
  FIXED
}

enum TaxTransaction {
  SALES
  PURCHASES
}

model TaxType {
  id              Int            @id @default(autoincrement())
  companyId       Int
  name            String
  calculationType TaxCalculation @default(PERCENTAGE)
  percent         Float?
  fixedAmount     BigInt?
  compound        Boolean        @default(false)
  description     String?
  transactionType TaxTransaction @default(SALES)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemTaxes       ItemTax[]
  appliedTaxes    AppliedTax[]
  expenseTaxes    ExpenseTax[]

  @@unique([companyId, name])
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  COMPLETED
}

enum PaidStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model Invoice {
  id                     Int           @id @default(autoincrement())
  companyId              Int
  creatorId              Int?
  customerId             Int
  type                   InvoiceType   @default(INVOICE)
  invoiceNumber          String
  sequenceNumber         Int
  customerSequenceNumber Int
  referenceNumber        String?
  invoiceDate            DateTime      @db.Date
  /// "HH:MM" when the company setting invoice_use_time is YES (spec §3.2).
  invoiceTime            String?
  dueDate                DateTime?     @db.Date
  currency               String
  exchangeRate           Float         @default(1)
  status                 InvoiceStatus @default(DRAFT)
  paidStatus             PaidStatus    @default(UNPAID)
  overdue                Boolean       @default(false)
  sent                   Boolean       @default(false)
  viewed                 Boolean       @default(false)
  taxPerItem             Boolean       @default(false)
  discountPerItem        Boolean       @default(false)
  taxIncluded            Boolean       @default(false)
  discountType           DiscountType  @default(FIXED)
  discount               Float         @default(0)
  discountVal            BigInt        @default(0)
  subTotal               BigInt        @default(0)
  tax                    BigInt        @default(0)
  total                  BigInt        @default(0)
  dueAmount              BigInt        @default(0)
  baseSubTotal           BigInt        @default(0)
  baseDiscountVal        BigInt        @default(0)
  baseTax                BigInt        @default(0)
  baseTotal              BigInt        @default(0)
  baseDueAmount          BigInt        @default(0)
  notes                  String?
  templateName           String        @default("invoice1")
  recurringInvoiceId     Int?
  relatedInvoiceId       Int?
  creditReason           String?
  uniqueHash             String        @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  company                Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer               Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recurringInvoice       RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  relatedInvoice         Invoice?      @relation("CreditNotes", fields: [relatedInvoiceId], references: [id], onDelete: SetNull)
  creditNotes            Invoice[]     @relation("CreditNotes")
  lines                  LineItem[]
  taxes                  AppliedTax[]
  allocations            PaymentAllocation[]
  onlinePayments         OnlinePayment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, type, status])
  @@index([customerId])
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  EXPIRED
  ACCEPTED
  REJECTED
}

model Estimate {
  id                     Int            @id @default(autoincrement())
  companyId              Int
  creatorId              Int?
  customerId             Int
  estimateNumber         String
  sequenceNumber         Int
  customerSequenceNumber Int
  referenceNumber        String?
  estimateDate           DateTime       @db.Date
  expiryDate             DateTime?      @db.Date
  currency               String
  exchangeRate           Float          @default(1)
  status                 EstimateStatus @default(DRAFT)
  taxPerItem             Boolean        @default(false)
  discountPerItem        Boolean        @default(false)
  taxIncluded            Boolean        @default(false)
  discountType           DiscountType   @default(FIXED)
  discount               Float          @default(0)
  discountVal            BigInt         @default(0)
  subTotal               BigInt         @default(0)
  tax                    BigInt         @default(0)
  total                  BigInt         @default(0)
  baseSubTotal           BigInt         @default(0)
  baseDiscountVal        BigInt         @default(0)
  baseTax                BigInt         @default(0)
  baseTotal              BigInt         @default(0)
  notes                  String?
  templateName           String         @default("estimate1")
  uniqueHash             String         @unique
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer               Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines                  LineItem[]
  taxes                  AppliedTax[]

  @@unique([companyId, estimateNumber])
  @@index([companyId, status])
  @@index([customerId])
}

enum RecurringStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum LimitBy {
  NONE
  COUNT
  DATE
}

model RecurringInvoice {
  id                Int             @id @default(autoincrement())
  companyId         Int
  creatorId         Int?
  customerId        Int
  startsAt          DateTime
  frequency         String
  status            RecurringStatus @default(ACTIVE)
  nextInvoiceAt     DateTime?
  limitBy           LimitBy         @default(NONE)
  limitCount        Int?
  limitDate         DateTime?       @db.Date
  sendAutomatically Boolean         @default(false)
  notifyCreator     Boolean         @default(false)
  lastError         String?
  lastAttemptAt     DateTime?
  currency          String
  exchangeRate      Float           @default(1)
  taxPerItem        Boolean         @default(false)
  discountPerItem   Boolean         @default(false)
  taxIncluded       Boolean         @default(false)
  discountType      DiscountType    @default(FIXED)
  discount          Float           @default(0)
  discountVal       BigInt          @default(0)
  subTotal          BigInt          @default(0)
  tax               BigInt          @default(0)
  total             BigInt          @default(0)
  notes             String?
  templateName      String          @default("invoice1")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines             LineItem[]
  taxes             AppliedTax[]
  invoices          Invoice[]
  runs              RecurringRun[]

  @@index([status, nextInvoiceAt])
}

model RecurringRun {
  id                 Int              @id @default(autoincrement())
  recurringInvoiceId Int
  scheduledFor       DateTime         @db.Date
  scheduledAt        DateTime
  invoiceId          Int?
  createdAt          DateTime         @default(now())
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@unique([recurringInvoiceId, scheduledAt])
}

model LineItem {
  id                 Int               @id @default(autoincrement())
  companyId          Int
  invoiceId          Int?
  estimateId         Int?
  recurringInvoiceId Int?
  itemId             Int?
  position           Int               @default(0)
  name               String
  description        String?
  unitName           String?
  quantity           Float
  price              BigInt
  discountType       DiscountType      @default(FIXED)
  discount           Float             @default(0)
  discountVal        BigInt            @default(0)
  tax                BigInt            @default(0)
  total              BigInt
  basePrice          BigInt            @default(0)
  baseDiscountVal    BigInt            @default(0)
  baseTax            BigInt            @default(0)
  baseTotal          BigInt            @default(0)
  exchangeRate       Float             @default(1)
  sourceLineId       Int?
  /// Answers of Item custom fields printed as line columns: { "<customFieldId>": "value" } (spec §3.14).
  customFields       Json?
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  estimate           Estimate?         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  item               Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  taxes              AppliedTax[]

  @@index([invoiceId])
  @@index([estimateId])
  @@index([recurringInvoiceId])
}

model AppliedTax {
  id                 Int               @id @default(autoincrement())
  companyId          Int
  taxTypeId          Int?
  name               String
  calculationType    TaxCalculation
  percent            Float?
  fixedAmount        BigInt?
  compound           Boolean           @default(false)
  amount             BigInt
  baseAmount         BigInt            @default(0)
  position           Int               @default(0)
  invoiceId          Int?
  estimateId         Int?
  recurringInvoiceId Int?
  lineItemId         Int?
  taxType            TaxType?          @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  estimate           Estimate?         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  lineItem           LineItem?         @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([estimateId])
  @@index([lineItemId])
}

model PaymentMethod {
  id        Int       @id @default(autoincrement())
  companyId Int
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments  Payment[]
  expenses  Expense[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, name])
}

model Payment {
  id                     Int            @id @default(autoincrement())
  companyId              Int
  creatorId              Int?
  customerId             Int
  paymentNumber          String
  sequenceNumber         Int
  customerSequenceNumber Int
  paymentDate            DateTime       @db.Date
  amount                 BigInt
  currency               String
  exchangeRate           Float          @default(1)
  baseAmount             BigInt
  paymentMethodId        Int?
  notes                  String?
  uniqueHash             String         @unique
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer               Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMethod          PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  allocations            PaymentAllocation[]
  onlinePayment          OnlinePayment?

  @@unique([companyId, paymentNumber])
  @@index([customerId])
}

model PaymentAllocation {
  id         Int     @id @default(autoincrement())
  paymentId  Int
  invoiceId  Int
  amount     BigInt
  baseAmount BigInt
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model ExpenseCategory {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses    Expense[]
  suppliers   Supplier[]
  billLines   BillLine[]
}

model Expense {
  id              Int             @id @default(autoincrement())
  companyId       Int
  creatorId       Int?
  expenseDate     DateTime        @db.Date
  expenseNumber   String?
  categoryId      Int
  amount          BigInt
  currency        String
  exchangeRate    Float           @default(1)
  baseAmount      BigInt
  paymentMethodId Int?
  customerId      Int?
  supplierId      Int?
  notes           String?
  receiptPath     String?
  receiptName     String?
  receiptMime     String?
  receiptSize     Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier        Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  taxes           ExpenseTax[]

  @@index([companyId, expenseDate])
}

model ExpenseTax {
  id        Int     @id @default(autoincrement())
  expenseId Int
  taxTypeId Int
  amount    BigInt
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  taxType   TaxType @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)

  @@unique([expenseId, taxTypeId])
}

model CustomField {
  id            Int      @id @default(autoincrement())
  companyId     Int
  name          String
  label         String
  slug          String
  modelType     String
  type          String
  placeholder   String?
  options       String[]
  defaultAnswer String?
  isRequired    Boolean  @default(false)
  order         Int      @default(0)
  placement     String   @default("internal")
  validation    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  values        CustomFieldValue[]

  @@unique([companyId, slug])
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  companyId     Int
  customFieldId Int
  modelType     String
  modelId       Int
  value         String?
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, modelType, modelId])
  @@index([modelType, modelId])
}

model Note {
  id        Int      @id @default(autoincrement())
  companyId Int
  type      String
  name      String
  notes     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, name])
}

model ExchangeRateLog {
  id           Int      @id @default(autoincrement())
  companyId    Int
  currency     String
  baseCurrency String
  rate         Float
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, currency])
}

model EmailLog {
  id           Int      @id @default(autoincrement())
  companyId    Int
  from         String
  to           String
  cc           String?
  bcc          String?
  subject      String
  body         String
  mailableType String
  mailableId   Int
  token        String   @unique
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([mailableType, mailableId])
}

model JobState {
  key       String   @id
  lastRunAt DateTime
}

/// Installation-wide settings managed by the platform administrator (spec §3.2 "Global").
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Outgoing mail configuration (spec §5.12 / §5.13). companyId null = platform default. Secrets are
/// AES-256-GCM encrypted (src/lib/secrets.ts) and never sent to the browser.
model MailConfig {
  id          Int      @id @default(autoincrement())
  companyId   Int?     @unique
  enabled     Boolean  @default(true)
  driver      String
  fromAddress String?
  fromName    String?
  /// Non-secret driver fields: host, port, username, encryption, domain, endpoint, region, key id.
  options     Json     @default("{}")
  /// Encrypted JSON of secret driver fields: password, secret, token.
  secrets     String?
  updatedAt   DateTime @updatedAt
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Exchange-rate provider (spec §3.16). The API key is AES-256-GCM encrypted and never sent to the browser.
model ExchangeRateProvider {
  id           Int      @id @default(autoincrement())
  companyId    Int
  driver       String
  keyEncrypted String
  currencies   String[]
  /// Driver options, e.g. { "planType": "FREE", "url": "https://..." } for currency_converter.
  driverConfig Json     @default("{}")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
}

// ---- Purchasing (spec §3.20, §4.14) -------------------------------------------------------

model Supplier {
  id                Int              @id @default(autoincrement())
  companyId         Int
  creatorId         Int?
  name              String
  contactName       String?
  email             String?
  phone             String?
  website           String?
  taxId             String?
  currency          String
  expenseCategoryId Int?
  paymentTerms      Int              @default(30)
  street1           String?
  street2           String?
  city              String?
  state             String?
  zip               String?
  country           String?
  notes             String?
  enabled           Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  bills             Bill[]
  payments          SupplierPayment[]
  recurringCosts    RecurringCost[]
  expenses          Expense[]

  @@index([companyId, name])
}

enum BillType {
  BILL
  SUPPLIER_CREDIT
}

enum BillStatus {
  DRAFT
  OPEN
  VOID
}

/// Bill or supplier credit (same document shape, spec §3.20). Money in minor units of `currency`.
model Bill {
  id                Int        @id @default(autoincrement())
  companyId         Int
  creatorId         Int?
  supplierId        Int
  type              BillType   @default(BILL)
  number            String
  sequenceNumber    Int
  reference         String?
  status            BillStatus @default(DRAFT)
  documentDate      DateTime   @db.Date
  dueDate           DateTime?  @db.Date
  currency          String
  exchangeRate      Float      @default(1)
  taxIncluded       Boolean    @default(false)
  subTotal          BigInt     @default(0)
  tax               BigInt     @default(0)
  total             BigInt     @default(0)
  baseTotal         BigInt     @default(0)
  dueAmount         BigInt     @default(0)
  baseDueAmount     BigInt     @default(0)
  notes             String?
  voidedAt          DateTime?
  voidReason        String?
  financialLockedAt DateTime?
  supplierSnapshot  Json       @default("{}")
  sourceBillId      Int?
  sourceExpenseId   Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier          Supplier   @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  sourceBill        Bill?      @relation("BillCredits", fields: [sourceBillId], references: [id], onDelete: SetNull)
  credits           Bill[]     @relation("BillCredits")
  lines             BillLine[]
  settlements       BillSettlement[] @relation("SettledBill")
  creditSettlements BillSettlement[] @relation("CreditSource")
  refunds           SupplierPayment[] @relation("RefundOfCredit")

  @@unique([companyId, type, number])
  @@index([companyId, type, status])
  @@index([supplierId])
}

model BillLine {
  id                Int             @id @default(autoincrement())
  billId            Int
  position          Int             @default(0)
  expenseCategoryId Int
  description       String
  quantity          Float
  price             BigInt
  discountType      DiscountType    @default(PERCENTAGE)
  discount          Float           @default(0)
  subTotal          BigInt
  discountVal       BigInt          @default(0)
  tax               BigInt          @default(0)
  total             BigInt
  baseTotal         BigInt          @default(0)
  sourceBillLineId  Int?
  bill              Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: NoAction)
  taxes             BillLineTax[]

  @@index([billId])
}

model BillLineTax {
  id              Int            @id @default(autoincrement())
  billLineId      Int
  taxTypeId       Int?
  name            String
  calculationType TaxCalculation
  percent         Float?
  fixedAmount     BigInt?
  compound        Boolean        @default(false)
  amount          BigInt
  baseAmount      BigInt         @default(0)
  billLine        BillLine       @relation(fields: [billLineId], references: [id], onDelete: Cascade)
}

enum SupplierPaymentType {
  PAYMENT
  REFUND
}

/// Supplier payment or supplier refund (spec §3.20). Status OPEN or VOID.
model SupplierPayment {
  id                Int                 @id @default(autoincrement())
  companyId         Int
  creatorId         Int?
  supplierId        Int
  type              SupplierPaymentType @default(PAYMENT)
  number            String
  sequenceNumber    Int
  reference         String?
  status            String              @default("OPEN")
  paymentDate       DateTime            @db.Date
  amount            BigInt
  baseAmount        BigInt
  currency          String
  exchangeRate      Float               @default(1)
  paymentMethodId   Int?
  notes             String?
  voidedAt          DateTime?
  voidReason        String?
  refundOfPaymentId Int?
  refundOfCreditId  Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  paymentMethod     PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  refundOfPayment   SupplierPayment?    @relation("PaymentRefunds", fields: [refundOfPaymentId], references: [id], onDelete: NoAction)
  refunds           SupplierPayment[]   @relation("PaymentRefunds")
  refundOfCredit    Bill?               @relation("RefundOfCredit", fields: [refundOfCreditId], references: [id], onDelete: NoAction)
  settlements       BillSettlement[]

  @@unique([companyId, type, number])
  @@index([supplierId])
}

/// Allocation of a supplier payment or a supplier credit to a bill (spec §3.20 "Allocations").
model BillSettlement {
  id                Int              @id @default(autoincrement())
  billId            Int
  supplierPaymentId Int?
  creditId          Int?
  amount            BigInt
  baseAmount        BigInt
  createdAt         DateTime         @default(now())
  bill              Bill             @relation("SettledBill", fields: [billId], references: [id], onDelete: NoAction)
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  credit            Bill?            @relation("CreditSource", fields: [creditId], references: [id], onDelete: Cascade)

  @@unique([billId, supplierPaymentId])
  @@unique([billId, creditId])
  @@index([supplierPaymentId])
  @@index([creditId])
}

/// Recurring bill or expense (spec §3.20, §4.14). `template` holds the line to generate.
model RecurringCost {
  id            Int             @id @default(autoincrement())
  companyId     Int
  creatorId     Int?
  supplierId    Int
  name          String
  mode          String          @default("BILL")
  status        RecurringStatus @default(ACTIVE)
  frequency     String
  startsAt      DateTime
  nextRunAt     DateTime?
  limitBy       LimitBy         @default(NONE)
  limitCount    Int?
  limitDate     DateTime?       @db.Date
  dueDays       Int             @default(30)
  createAsDraft Boolean         @default(false)
  notifyCreator Boolean         @default(false)
  template      Json
  runCount      Int             @default(0)
  lastRunAt     DateTime?
  lastError     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier        @relation(fields: [supplierId], references: [id], onDelete: NoAction)

  @@index([status, nextRunAt])
}

/// Online payment gateway for the customer portal ("stripe" or "demo"). Secrets are AES-256-GCM encrypted JSON
/// (secretKey, webhookSecret) and never sent to the browser.
model PaymentGateway {
  id        Int      @id @default(autoincrement())
  companyId Int      @unique
  enabled   Boolean  @default(true)
  driver    String
  /// Non-secret fields, e.g. { "publishableKey": "pk_..." }.
  options   Json     @default("{}")
  secrets   String?
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum OnlinePaymentStatus {
  PENDING
  PAID
  EXPIRED
}

/// One checkout attempt from the portal. providerRef is the idempotency key: a PAID row has exactly one Payment.
model OnlinePayment {
  id          Int                 @id @default(autoincrement())
  companyId   Int
  customerId  Int
  invoiceId   Int
  driver      String
  providerRef String              @unique
  amount      BigInt
  currency    String
  status      OnlinePaymentStatus @default(PENDING)
  paymentId   Int?                @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment     Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}
